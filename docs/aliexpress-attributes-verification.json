 "root_causes": [
  {
   "id": "R1",
   "finding": "采集/复制进草稿的商品只有「自定义属性」(attrName/attrValue)，没有速卖通系统属性 id",
   "evidence": "40 个 draft 中 23 个有类目，这 23 个商品系统属性=0、全部为自定义属性；类目 100007204 的 4 个必填属性（Brand Name / Origin / Charge Status / High-concerned chemical）因此全部无值，且模板商品里的 4 个系统属性未套用",
   "affected": {
    "draft_with_category": 23,
    "required_missing": 92,
    "template_attrs_missing": 92
   },
   "fix": "按名称/中文名/别名把自定义属性映射到类目属性；枚举值反查 attrValueId；商品没有的必填属性用模板商品系统属性兜底，再退到通用默认值"
  },
  {
   "id": "R2",
   "finding": "「待发布(editingRequired)」商品有系统属性 id，但 attrName 为空（名称缺失）",
   "evidence": "20 个 editingRequired 全部存在该问题，共 80 条系统属性（每个商品 4 条：Brand Name/Origin/Charge Status/High-concerned chemical 的 attrNameId 有效、attrValueId 有效，只有 attrName=None）",
   "impact": "店小秘编辑器能显示值但列表/快照按名称匹配会漏项；DianxiaomiClient.template_snapshot 只收 attrName 非空的项（见 dianxiaomi.py:346），这类商品做模板快照会丢系统属性",
   "fix": "merge_attributes 按类目定义把 attrName 回填；模板快照/UI 展示也应优先用 attrNameId 反查名称"
  },
  {
   "id": "R3",
   "finding": "40 个 draft 中 17 个完全没有类目（categoryId=null），但都带 forecastCategoryId 预测类目候选",
   "evidence": "17/17 都有 2~5 个预测类目，且全部能通过 /api/smtCategory/getByCategoryId.json 校验为叶子类目（例如 Water Well Drilling Rig / Mine Drilling Rig & Rock Drill）；首个候选与标题语义一致（如 100M 水井钻机 → 202181206 Water Well Drilling Rig）",
   "fix": "报告给出建议类目与「若采纳预测类目」的属性补全预估；真正写类目属于平台写操作，本次只读未写，需 UI 让用户确认后由保存流程写入"
  },
  {
   "id": "R4",
   "finding": "SKU 维度与本类目实际匹配（0 条真实不匹配），但 plug 库属性容易被误报",
   "evidence": "20 个 editingRequired 的 SKU 用 skuPropertyId=14(Color)+400079803(plug)，其中 plug 父级 400081003 不在 attributeList；若把 plug_parent_property_id 当作 SKU 维度会误报 20/20。模板商品（已在线）使用同一结构，说明 400079803/400081003 是平台合法的 plug 库属性。修正后 60/60 商品 SKU 维度检查通过",
   "fix": "合法 SKU 维度 = 类目 sku 属性 + 模板商品 SKU 用到的 id（含 plug 父级）+ 人工白名单；plug_parent_property_id 不计入「商品使用的维度」"
  },
  {
   "id": "R5",
   "finding": "预测类目 Water Well Drilling Rig(202181206) 的必填属性 Drill Type 无法从模板/默认值补",
   "evidence": "4 个无类目商品采纳预测类目后仍缺 Drill Type；AI 兜底（2 次真实调用，均有枚举校验）成功把同类商品的 Drill Type 补成 Rotary Hammer Drill(id 8030)",
   "fix": "保留为「AI 建议/人工确认」状态；本次限流 ≤2 次真实 AI 调用，其余留待 UI 逐条确认"
  }
 ],
